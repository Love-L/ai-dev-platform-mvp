{
  "name": "ai-dev-platform-mvp",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:tools": "powershell -ExecutionPolicy Bypass -File scripts/bundle-tools.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:l1": "vitest run src/",
    "test:l3": "vitest run tests/l3-fullstack",
    "test:l5": "vitest run tests/l5-chaos",
    "test:ipc": "vitest run tests/l6-ipc",
    "test:e2e": "playwright test",
    "test:l4": "vitest run --config vitest.l4.config.ts",
    "test:pages": "vitest run src/pages",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:win": "powershell -ExecutionPolicy Bypass -File scripts/run-tests-ascii.ps1",
    "test:win:ipc": "powershell -ExecutionPolicy Bypass -File scripts/run-tests-ascii.ps1 -Target tests/l6-ipc",
    "verify": "npm run test:l1 && npm run test:ipc && npm run test:l3 && npm run test:l5",
    "verify:win": "npm run test:win"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.294.0",
    "react": "^18.3.1",
    "react-countup": "^6.5.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
