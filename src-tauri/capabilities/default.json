{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ACE 默认权限配置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:webview:default",
    "core:tray:default",
    "shell:default"
  ]
}
