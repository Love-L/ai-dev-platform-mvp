{
  "productName": "ACE",
  "version": "2.3.1",
  "identifier": "com.ace.collaboration-engine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run bundle:tools && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ACE - AI Collaboration Engine",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/**", "$APPDATA/exports/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Love-L/ai-dev-platform-mvp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1MjRERTEzRTBBRDAxQjkKUldTNUFhM2dFOTRrUmVjVXhCRUhoVzB2NmI3SGovT2RGRVNTMTVrZFR6ZHo0VmpHZ0wvcmpTR28K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/tools/": "tools/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
